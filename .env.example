# Copy to .env and fill in whichever alert channels you want.
# Without these, `watch` alerts only print to the console.

# Telegram: create a bot with @BotFather, message it once, then find your
# chat id at https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Channel settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# stockpicks website (python -m stockpicks serve). See stockpicks/README.md.
# ---------------------------------------------------------------------------
SITE_NAME=LongHold
# Your public address. Stripe and password-reset links point here.
BASE_URL=http://localhost:8000
SUPPORT_EMAIL=
# Required: the SEC blocks requests without a name and contact email.
SEC_USER_AGENT=LongHold you@example.com
# Where the database and daily picks are stored.
DATA_DIR=data
# Price data for valuation: stooq (free, no key) or finnhub (free key at finnhub.io).
PRICE_SOURCE=stooq
FINNHUB_API_KEY=
PICKS_COUNT=25
MIN_MARKET_CAP=2000000000

# Stripe: create a $10/month recurring price, a webhook pointing at
# BASE_URL/stripe/webhook, and turn on the customer portal.
PRICE_LABEL=$10/month
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional: SMTP for password-reset emails (port 587 STARTTLS or 465 SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
