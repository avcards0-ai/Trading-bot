# =============================================================================
# MemeGuard configuration. Copy to `.env` and fill in what you need.
# NEVER commit `.env`. NEVER paste private keys or seed phrases into chats/logs.
# Secrets listed here are scrubbed from every log line, but keep them out of
# shell history and screenshots anyway.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Optional JSON log file (secrets are scrubbed before writing).
LOG_FILE=
LOG_PRETTY=true

# ---- API server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Admin API key (>= 24 chars). Required for POST endpoints (scan, paper-trade,
# strategy, engine control). Admin endpoints are DISABLED while this is empty.
# Generate one with: openssl rand -hex 32
API_KEY=
# Also require API_KEY for read endpoints (recommended if HOST is not localhost).
REQUIRE_AUTH_FOR_READS=false

# ---- Database ---------------------------------------------------------------
# PostgreSQL (recommended, used by docker compose):
#   DATABASE_URL=postgres://memeguard:memeguard@localhost:5432/memeguard
# Embedded PostgreSQL (PGlite) for zero-dependency local runs:
#   DATABASE_URL=pglite://./data/pglite     (persistent directory)
#   DATABASE_URL=pglite://memory            (in-memory, lost on exit)
DATABASE_URL=pglite://./data/pglite
DB_AUTO_MIGRATE=true
# Used by docker compose for its PostgreSQL service (compose overrides DATABASE_URL).
# Required for `docker compose up`; use a long random value (openssl rand -hex 24).
POSTGRES_PASSWORD=

# ---- Trading mode -----------------------------------------------------------
# paper (default) simulates everything with a virtual wallet.
# live requires ALL of: the exact confirmation phrase below, a wallet, RPC_URL,
# API_KEY, and REQUIRE_HONEYPOT_CHECK=true. Otherwise the process refuses to start.
TRADING_MODE=paper
LIVE_TRADING_CONFIRMATION=
# Additional absolute cap per live position in USD (on top of MAX_POSITION_PERCENT).
LIVE_MAX_POSITION_USD=50
# Let the engine open positions automatically when every risk check passes.
AUTO_TRADE=true
ENGINE_AUTOSTART=true

# ---- Paper trading simulation -------------------------------------------------
PAPER_STARTING_BALANCE_USD=10000
PAPER_DEX_FEE_PERCENT=0.25
# Probability that a simulated transaction fails (network fee is still charged).
PAPER_FAILURE_RATE=0.02
# Set for reproducible simulated fills.
PAPER_RANDOM_SEED=

# ---- HARD risk limits (runtime strategy updates may only make these stricter) --
MAX_POSITION_PERCENT=2
# Max loss per UTC day, percent of day-start equity. Halts new entries.
MAX_DAILY_LOSS=5
# Max drawdown from peak equity, percent. Halts trading until manually resumed.
MAX_DRAWDOWN=20
MAX_OPEN_POSITIONS=5
# Minimum pool liquidity in USD.
MIN_LIQUIDITY=25000
# Maximum acceptable RUG_SCORE (0-100).
MAX_RUG_SCORE=35
# Maximum expected entry slippage / price impact, percent.
MAX_SLIPPAGE=3
# Exits tolerate more slippage so a collapsing position can still be closed.
EXIT_MAX_SLIPPAGE=15
# Minimum token (pair) age in minutes.
MIN_TOKEN_AGE=30
# A position may not exceed this percent of pool liquidity.
MAX_LIQUIDITY_SHARE_PERCENT=1
MIN_POSITION_USD=10
# Refuse entries unless sellability/honeypot status was verified.
REQUIRE_HONEYPOT_CHECK=true
# Market data older than this is considered stale -> no trade.
MAX_DATA_AGE_SECONDS=120
# Backtest: a single trade losing more than this percent is flagged catastrophic.
CATASTROPHIC_LOSS_PERCENT=50

# ---- Strategy defaults (editable at runtime via POST /strategy) ---------------
STRATEGY_STOP_LOSS_PERCENT=15
STRATEGY_TAKE_PROFIT_PERCENT=40
# 0 disables the trailing stop.
STRATEGY_TRAILING_STOP_PERCENT=0
STRATEGY_MAX_HOLD_MINUTES=240
STRATEGY_RISK_PER_TRADE_PERCENT=0.5
STRATEGY_MIN_SCORE=60
STRATEGY_MIN_BUY_SELL_RATIO=1.2
STRATEGY_MIN_VOLUME_1H_USD=20000
STRATEGY_MAX_PRICE_CHANGE_5M_PERCENT=25
STRATEGY_MIN_PRICE_CHANGE_1H_PERCENT=0
STRATEGY_MAX_TOKEN_AGE_MINUTES=1440
STRATEGY_EXIT_RUG_SCORE=50
STRATEGY_EXIT_LIQUIDITY_DROP_PERCENT=30

# ---- Engine -----------------------------------------------------------------
CHAINS=solana,base,ethereum,bsc
DISCOVERY_SOURCES=geckoterminal,dexscreener
DISCOVERY_INTERVAL_SECONDS=60
MONITOR_INTERVAL_SECONDS=20
WATCHLIST_INTERVAL_SECONDS=180
WATCHLIST_BATCH_SIZE=10
WATCHLIST_MAX_AGE_HOURS=24
METRICS_INTERVAL_SECONDS=60
SECURITY_REFRESH_SECONDS=300
ANALYSIS_CONCURRENCY=2
MAX_QUEUE_SIZE=200
# Number of top holders analysed for wallet age / funding clusters (0 disables).
WALLET_ANALYSIS_TOP_N=10
FRESH_WALLET_AGE_HOURS=72
SOURCE_TIMEOUT_MS=15000

# ---- Blockchain RPC -----------------------------------------------------------
# Solana RPC endpoint (required for Solana contract/holder analysis and live trading).
# The public endpoint is heavily rate-limited; use a dedicated provider.
RPC_URL=
# Optional EVM RPC endpoints (bytecode, proxy and owner analysis).
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=

# ---- Wallet (LIVE mode only) ----------------------------------------------------
# Solana secret key as base58 or a JSON byte array. Prefer WALLET_KEYPAIR_PATH
# (a keypair file with 0600 permissions) over putting the key in the environment.
# Use a dedicated hot wallet holding only what you can afford to lose.
WALLET_PRIVATE_KEY=
WALLET_KEYPAIR_PATH=

# ---- Data providers -----------------------------------------------------------
# GoPlus works without keys at a low rate; app key/secret raise limits.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# Etherscan V2 multichain key: contract verification, deployer history, wallet ages (EVM).
ETHERSCAN_API_KEY=
HONEYPOT_IS_API_KEY=
RUGCHECK_API_KEY=
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Requests per minute per provider (client-side limiter).
DEXSCREENER_RPM=240
GECKOTERMINAL_RPM=25
GOPLUS_RPM=25
RUGCHECK_RPM=30
HONEYPOT_IS_RPM=30
ETHERSCAN_RPM=240
SOLANA_RPC_RPM=300
EVM_RPC_RPM=300
JUPITER_RPM=50

# ---- Alerts -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Minimum severity pushed to Telegram/Discord: info | warning | critical
ALERT_MIN_SEVERITY=warning
ALERT_COOLDOWN_SECONDS=900
ALERT_MAX_PER_TYPE_PER_HOUR=30

# ---- Optional LLM second opinion ------------------------------------------------
# The deterministic rug model always runs. When enabled, an LLM reviews each report
# and may ESCALATE risk (never lower it).
ANTHROPIC_API_KEY=
LLM_REVIEW_ENABLED=false
LLM_REVIEW_MODEL=claude-opus-5
# If true, a failed/unavailable LLM review blocks trading (fail closed).
LLM_REVIEW_REQUIRED=false
LLM_REVIEW_TIMEOUT_MS=30000
