{
  "name": "memeguard",
  "version": "1.0.0",
  "private": true,
  "description": "Rug-detection first, risk-gated meme-coin analysis and trading platform (paper trading by default).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @memeguard/backend",
    "dev:frontend": "npm run dev -w @memeguard/frontend",
    "build": "npm run build -w @memeguard/backend && npm run build -w @memeguard/frontend",
    "start": "npm run start -w @memeguard/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit -w @memeguard/backend",
    "test:integration": "npm run test:integration -w @memeguard/backend",
    "db:generate": "npm run db:generate -w @memeguard/backend",
    "db:migrate": "npm run db:migrate -w @memeguard/backend",
    "scan": "npm run scan -w @memeguard/backend --",
    "backtest": "npm run backtest -w @memeguard/backend --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
